# Dev/debug outputs, Python caches, and exported model artifacts.
# Keep reproducibility scripts in dev_tools tracked while ignoring its local images,
# logs, exported models, and one-off diagnostics.
/dev_tools/*
!/dev_tools/gen_golden_vectors.py
!/dev_tools/requirements.txt
!/dev_tools/analyze_tracking_diagnostics.py
!/dev_tools/collect_tracking_diagnostics.py
!/dev_tools/test_tracking_diagnostics.py
!/dev_tools/device_video_test.py
!/dev_tools/test_device_video_test.py
!/dev_tools/field_video_replay.py
!/dev_tools/ball_video_lab/
!/dev_tools/ball_video_lab/**
/dev_tools/ball_video_lab/outputs/
/dev_tools/ball_video_lab/runs/
/dev_tools/ball_video_lab/.venv/
/Ultralytics/
__pycache__/
.pytest_cache/
*.py[cod]

# Anchor model ignores to the repository root. The model under
# app/src/main/assets ships in the APK and must remain tracked.
/best.pt
/best.onnx

# DSH harness scratch space and device transfer reports (machine-local).
/.dsh_tmp/
/.dsh_transfer_report.txt
